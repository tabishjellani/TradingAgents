# =============================================================================
# TradingAgents Backend & Engine Configuration Example
# Copy to `backend/.env` or root `.env` (Never commit your real secrets to Git!)
# =============================================================================

# Service Environment Mode ('development' | 'production')
ENVIRONMENT=development
DEBUG=true

# Server Binding
HOST=127.0.0.1
PORT=8000

# Cloudflare Gateway Shared Secret (Optional in dev, required in zero-trust prod)
GATEWAY_SHARED_SECRET=your-shared-gateway-secret-placeholder

# -----------------------------------------------------------------------------
# Supabase Integration (Server-Side)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://iajgazxydwxkvgkicmti.supabase.co
SUPABASE_ANON_KEY=sb_publishable_UhgBWH3nX1McUNeSHZyWHg_cvSAldPz

# Required if using symmetric HS256 JWT signing.
# Leave blank if using modern asymmetric RS256/ES256 (verified via JWKS endpoint).
SUPABASE_JWT_SECRET=5dbefa36-c386-4882-be3f-208aa7d83e3a

# Optional: Only needed for explicit background system maintenance tasks.
# User CRUD operations never use the service role key.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imlhamdhenh5ZHd4a3Zna2ljbXRpIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MjY4NjMzMCwiZXhwIjoyMTA4MjYyMzMwfQ.Nf8fNzQJ322NK-R6JJ-EesHEHppYRjKCRWtppy7xfsc

# -----------------------------------------------------------------------------
# AI Provider Keys (Server-Side Only - or configure via Admin Settings UI)
# -----------------------------------------------------------------------------
# Google Gemini (Recommended zero-cost default)

GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY_HERE
# or GEMINI_API_KEY=

# OpenAI (Optional)
OPENAI_API_KEY=

# Groq Cloud (Optional fast inference)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=

# Master encryption key for server-side secrets vault (Optional in dev, recommended in container/stateless prod)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEY=

# -----------------------------------------------------------------------------
# AI Engine Model Defaults
# -----------------------------------------------------------------------------
# Default AI Provider ('google' | 'openai' | 'groq' | 'anthropic')
DEFAULT_AI_PROVIDER=google
# Verified Official: 'gemini-2.0-flash', 'gemini-1.5-flash'
# Upstream Speculative: 'gemini-3.8-flash'
DEFAULT_QUICK_MODEL=gemini-2.0-flash
DEFAULT_DEEP_MODEL=gemini-2.0-flash
MAX_JOB_TIMEOUT_SECONDS=300
USER_DAILY_JOB_QUOTA=20

# -----------------------------------------------------------------------------
# Mandatory Safety Controls (Live Trading Hard-Disabled by Default)
# -----------------------------------------------------------------------------
ENABLE_LIVE_TRADING=false
BROKER_SANDBOX_MODE=true
MAX_ORDER_NOTIONAL_USD=1000.0
DAILY_LOSS_LIMIT_PCT=2.0
