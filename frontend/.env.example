# TradingAgents PWA Frontend Environment Configuration
# Copy this file to .env.local or set in Cloudflare Pages / deployment environment

# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# API Gateway Base URL
# When hosted on the same domain or behind Cloudflare Worker reverse-proxy, leave empty to default to relative /api/v1
# If frontend is on Cloudflare Pages and backend is on a separate domain / Cloudflare Worker, set the full URL:
# VITE_API_BASE_URL=https://gateway.yourdomain.workers.dev/api/v1
VITE_API_BASE_URL=
